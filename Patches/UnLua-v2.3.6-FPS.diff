+++ b/Plugins/UnLua/Source/UnLuaEditor/Private/AssetMenu/UnLuaAssetMenu.cpp
@@ -0,0 +1,278 @@
+#include "AssetMenu/UnLuaAssetMenu.h"
+#include "AssetMenu/UnLuaLuaEditorSettings.h"
+
+#include "AssetRegistry/AssetData.h"
+#include "ContentBrowserMenuContexts.h"
+#include "EdGraph/EdGraph.h"
+#include "EdGraph/EdGraphNode.h"
+#include "EdGraph/EdGraphPin.h"
+#include "EdGraphSchema_K2.h"
+#include "Engine/Blueprint.h"
+#include "Framework/Notifications/NotificationManager.h"
+#include "LuaModuleLocator.h"
+#include "Misc/Paths.h"
+#include "Styling/AppStyle.h"
+#include "ToolMenus.h"
+#include "UnLuaInterface.h"
+#include "UnLuaPrivate.h"
+#include "UnLuaSettings.h"
+#include "Widgets/Notifications/SNotificationList.h"
+
+#define LOCTEXT_NAMESPACE "UnLuaAssetMenu"
+
+DEFINE_LOG_CATEGORY_STATIC(LogUnLuaAssetMenu, Log, All);
+
+namespace
+{
+    const FName MenuOwner("UnLuaAssetMenu");
+    const FName AssetContextMenuName("ContentBrowser.AssetContextMenu");
+}
+
+void FUnLuaAssetMenu::Register()
+{
+    UToolMenus* ToolMenus = UToolMenus::Get();
+    if (!ToolMenus)
+        return;
+
+    FToolMenuOwnerScoped OwnerScoped(MenuOwner);
+    UToolMenu* Menu = ToolMenus->ExtendMenu(AssetContextMenuName);
+    Menu->AddDynamicSection(
+        "UnLuaScripts",
+        FNewToolMenuDelegate::CreateStatic(&FUnLuaAssetMenu::FillAssetContextMenu),
+        FToolMenuInsert("CommonAssetActions", EToolMenuInsertType::After));
+}
+
+void FUnLuaAssetMenu::Unregister()
+{
+    if (UToolMenus* ToolMenus = UToolMenus::Get())
+        ToolMenus->UnregisterOwnerByName(MenuOwner);
+}
+
+void FUnLuaAssetMenu::FillAssetContextMenu(UToolMenu* Menu)
+{
+    if (!Menu)
+        return;
+
+    const UContentBrowserAssetContextMenuContext* Context =
+        Menu->FindContext<UContentBrowserAssetContextMenuContext>();
+    if (!Context)
+        return;
+
+    TArray<FUnLuaScriptReference> Scripts;
+    for (const FAssetData& AssetData : Context->SelectedAssets)
+    {
+        FUnLuaScriptReference Script;
+        if (ResolveAsset(AssetData, Script))
+            Scripts.Add(MoveTemp(Script));
+    }
+
+    if (Scripts.IsEmpty())
+        return;
+
+    FToolMenuSection& Section = Menu->AddSection("UnLua", LOCTEXT("Section", "UnLua"));
+    const FText OpenLabel = Scripts.Num() == 1
+        ? LOCTEXT("OpenLuaScript", "Open Lua Script")
+        : FText::Format(LOCTEXT("OpenLuaScripts", "Open Lua Scripts ({0})"), Scripts.Num());
+
+    Section.AddMenuEntry(
+        "OpenLuaScript",
+        OpenLabel,
+        LOCTEXT("OpenLuaScriptTooltip", "Open the Lua file resolved from UnLua GetModuleName"),
+        FSlateIcon(FAppStyle::GetAppStyleSetName(), "Icons.Edit"),
+        FUIAction(FExecuteAction::CreateStatic(&FUnLuaAssetMenu::OpenScripts, Scripts)));
+
+    Section.AddMenuEntry(
+        "RevealLuaScript",
+        LOCTEXT("RevealLuaScript", "Reveal Lua Script in Explorer"),
+        LOCTEXT("RevealLuaScriptTooltip", "Reveal the bound Lua file in the system file explorer"),
+        FSlateIcon(FAppStyle::GetAppStyleSetName(), "ContentBrowser.ShowInExplorer"),
+        FUIAction(FExecuteAction::CreateStatic(&FUnLuaAssetMenu::RevealScripts, Scripts)));
+}
+
+bool FUnLuaAssetMenu::ResolveAsset(
+    const FAssetData& AssetData,
+    FUnLuaScriptReference& OutReference)
+{
+    if (!AssetData.IsValid() || !AssetData.IsInstanceOf(UBlueprint::StaticClass()))
+        return false;
+
+    const UBlueprint* Blueprint = Cast<UBlueprint>(AssetData.GetAsset());
+    if (!Blueprint)
+        return false;
+
+    OutReference.AssetName = Blueprint->GetName();
+    OutReference.ModuleName = ReadModuleName(Blueprint);
+    if (OutReference.ModuleName.IsEmpty())
+        return false;
+
+    OutReference.AbsolutePath = ModuleNameToFilePath(OutReference.ModuleName);
+    OutReference.bFileExists = FPaths::FileExists(OutReference.AbsolutePath);
+    return true;
+}
+
+FString FUnLuaAssetMenu::ReadModuleName(const UBlueprint* Blueprint)
+{
+    if (UClass* GeneratedClass = Blueprint->GeneratedClass)
+    {
+        const UUnLuaSettings* Settings = GetDefault<UUnLuaSettings>();
+        if (Settings && Settings->ModuleLocatorClass)
+        {
+            ULuaModuleLocator* Locator =
+                Cast<ULuaModuleLocator>(Settings->ModuleLocatorClass->GetDefaultObject());
+            if (Locator)
+            {
+                const FString Located = NormalizeModuleName(Locator->Locate(GeneratedClass));
+                if (!Located.IsEmpty())
+                    return Located;
+            }
+        }
+    }
+
+    return NormalizeModuleName(ReadModuleNameFromGraph(Blueprint));
+}
+
+FString FUnLuaAssetMenu::ReadModuleNameFromGraph(const UBlueprint* Blueprint)
+{
+    for (const FBPInterfaceDescription& Description : Blueprint->ImplementedInterfaces)
+    {
+        if (Description.Interface != UUnLuaInterface::StaticClass())
+            continue;
+
+        for (const UEdGraph* Graph : Description.Graphs)
+        {
+            if (!Graph || Graph->GetFName() != FName(TEXT("GetModuleName")))
+                continue;
+
+            for (const UEdGraphNode* Node : Graph->Nodes)
+            {
+                if (!Node)
+                    continue;
+
+                for (const UEdGraphPin* Pin : Node->Pins)
+                {
+                    if (Pin
+                        && Pin->Direction == EGPD_Output
+                        && Pin->PinType.PinCategory == UEdGraphSchema_K2::PC_String
+                        && !Pin->DefaultValue.IsEmpty())
+                    {
+                        return Pin->DefaultValue;
+                    }
+                }
+            }
+        }
+    }
+
+    return FString();
+}
+
+FString FUnLuaAssetMenu::NormalizeModuleName(FString ModuleName)
+{
+    ModuleName.TrimStartAndEndInline();
+    ModuleName.ReplaceInline(TEXT("\\"), TEXT("."));
+    ModuleName.ReplaceInline(TEXT("/"), TEXT("."));
+    if (ModuleName.EndsWith(TEXT(".lua"), ESearchCase::IgnoreCase))
+        ModuleName.LeftChopInline(4);
+    if (ModuleName.StartsWith(TEXT("Script.")))
+        ModuleName.RightChopInline(7);
+    return ModuleName;
+}
+
+FString FUnLuaAssetMenu::ModuleNameToFilePath(const FString& ModuleName)
+{
+    const FString RelativePath =
+        NormalizeModuleName(ModuleName).Replace(TEXT("."), TEXT("/")) + TEXT(".lua");
+    return FPaths::ConvertRelativePathToFull(GLuaSrcFullPath / RelativePath);
+}
+
+void FUnLuaAssetMenu::OpenScripts(TArray<FUnLuaScriptReference> Scripts)
+{
+    for (const FUnLuaScriptReference& Script : Scripts)
+    {
+        if (Script.bFileExists)
+            OpenScript(Script.AbsolutePath);
+        else
+            NotifyMissing(Script);
+    }
+}
+
+void FUnLuaAssetMenu::OpenScript(const FString& AbsolutePath)
+{
+    const UUnLuaLuaEditorSettings* Settings = GetDefault<UUnLuaLuaEditorSettings>();
+    if (Settings && Settings->OpenMode == EUnLuaExternalEditorMode::CustomExecutable)
+    {
+        FString Executable = Settings->CustomEditorExecutable.FilePath;
+        if (FPaths::IsRelative(Executable))
+            Executable = FPaths::ConvertRelativePathToFull(Executable);
+
+        if (FPaths::FileExists(Executable))
+        {
+            FString Arguments = Settings->CustomEditorArguments;
+            if (Arguments.Contains(TEXT("{File}")))
+                Arguments.ReplaceInline(TEXT("{File}"), *AbsolutePath);
+            else
+                Arguments += FString::Printf(TEXT(" \"%s\""), *AbsolutePath);
+            Arguments.ReplaceInline(TEXT("{Line}"), TEXT("1"));
+
+            const FProcHandle Process = FPlatformProcess::CreateProc(
+                *Executable, *Arguments, true, false, false, nullptr, 0, nullptr, nullptr);
+            if (Process.IsValid())
+                return;
+
+            NotifyEditorFallback(
+                FString::Printf(TEXT("Could not launch custom editor: %s"), *Executable));
+        }
+        else
+        {
+            NotifyEditorFallback(
+                FString::Printf(TEXT("Custom editor does not exist: %s"), *Executable));
+        }
+    }
+
+    FPlatformProcess::LaunchFileInDefaultExternalApplication(*AbsolutePath);
+}
+
+void FUnLuaAssetMenu::RevealScripts(TArray<FUnLuaScriptReference> Scripts)
+{
+    for (const FUnLuaScriptReference& Script : Scripts)
+    {
+        if (Script.bFileExists)
+            FPlatformProcess::ExploreFolder(*Script.AbsolutePath);
+        else
+            NotifyMissing(Script);
+    }
+}
+
+void FUnLuaAssetMenu::NotifyMissing(const FUnLuaScriptReference& Script)
+{
+    const FText Text = FText::Format(
+        LOCTEXT("LuaFileMissing", "Lua file not found: {0}"),
+        FText::FromString(Script.AbsolutePath));
+    FNotificationInfo Info(Text);
+    Info.ExpireDuration = 5.0f;
+    Info.bUseSuccessFailIcons = true;
+    FSlateNotificationManager::Get().AddNotification(Info)->SetCompletionState(
+        SNotificationItem::CS_Fail);
+
+    UE_LOG(
+        LogUnLuaAssetMenu,
+        Warning,
+        TEXT("Lua script not found for %s (module=%s, path=%s)"),
+        *Script.AssetName,
+        *Script.ModuleName,
+        *Script.AbsolutePath);
+}
+
+void FUnLuaAssetMenu::NotifyEditorFallback(const FString& Reason)
+{
+    const FText Text = FText::Format(
+        LOCTEXT("LuaEditorFallback", "{0}. Falling back to the system default application."),
+        FText::FromString(Reason));
+    FNotificationInfo Info(Text);
+    Info.ExpireDuration = 5.0f;
+    Info.bUseSuccessFailIcons = true;
+    FSlateNotificationManager::Get().AddNotification(Info)->SetCompletionState(
+        SNotificationItem::CS_Fail);
+    UE_LOG(LogUnLuaAssetMenu, Warning, TEXT("%s"), *Text.ToString());
+}
+
+#undef LOCTEXT_NAMESPACE
