+#include "UnLuaLuaEditorSettings.generated.h"
+
+UENUM()
+enum class EUnLuaExternalEditorMode : uint8
+{
+    SystemDefault UMETA(DisplayName = "System Default"),
+    CustomExecutable UMETA(DisplayName = "Custom Editor"),
+};
+
+/** Per-user preferences for opening Lua files from the Unreal Editor. */
+UCLASS(Config = EditorPerProjectUserSettings, meta = (DisplayName = "UnLua Lua Editor"))
+class UUnLuaLuaEditorSettings : public UDeveloperSettings
+{
+    GENERATED_BODY()
+
+public:
+    UPROPERTY(Config, EditAnywhere, Category = "Lua Editor")
+    EUnLuaExternalEditorMode OpenMode = EUnLuaExternalEditorMode::SystemDefault;
+
+    UPROPERTY(
+        Config,
+        EditAnywhere,
+        Category = "Lua Editor",
+        meta = (
+            EditCondition = "OpenMode == EUnLuaExternalEditorMode::CustomExecutable",
+            EditConditionHides,
+            FilePathFilter = "Executable files (*.exe)|*.exe"
+        )
+    )
+    FFilePath CustomEditorExecutable;
+
+    /**
+     * Arguments passed to the custom editor.
+     * Tokens: {File} = absolute Lua path, {Line} = 1.
+     * Cursor: -g "{File}:{Line}", VS Code: --goto "{File}:{Line}"
+     */
+    UPROPERTY(
+        Config,
+        EditAnywhere,
+        Category = "Lua Editor",
+        meta = (
+            EditCondition = "OpenMode == EUnLuaExternalEditorMode::CustomExecutable",
+            EditConditionHides
+        )
+    )
+    FString CustomEditorArguments = TEXT("\"{File}\"");
+
+    virtual FName GetCategoryName() const override
+    {
+        return TEXT("Plugins");
+    }
+};
